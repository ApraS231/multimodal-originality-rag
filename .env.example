# =============================================================================
# TEMPLAT KONFIGURASI VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# SISTEM DETEKSI ORISINALITAS LAPORAN STITEK BONTANG
# =============================================================================
# Salin berkas ini menjadi '.env' di direktori akar 'Project-AI' sebelum
# menjalankan perintah 'docker compose up -d'.
# CATATAN KEAMANAN: Jangan pernah mengunggah berkas '.env' asli ke Git!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. KREDENSIAL DATABASE POSTGRESQL & SUPABASE
# -----------------------------------------------------------------------------
# URL koneksi ke PostgreSQL Supabase (dengan mode pooling Port 6543 / PgBouncer)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# URL koneksi langsung ke PostgreSQL Supabase (Port 5432) untuk migrasi Prisma
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# URL proyek Supabase (contoh: https://xyzcompany.supabase.co)
TAUTAN_SUPABASE=https://your-project-id.supabase.co

# Kunci API Service Role Supabase (untuk otorisasi bypass RLS tingkat server)
KUNCI_API_SUPABASE=your-supabase-service-role-key-here

# -----------------------------------------------------------------------------
# 2. KEAMANAN OTENTIKASI & TOKEN JWT
# -----------------------------------------------------------------------------
# Kunci rahasia untuk enkripsi token JWT dan AES-GCM (minimal 32 karakter unik)
JWT_SECRET=generate-a-very-strong-secret-key-with-minimum-32-chars-long-here

# -----------------------------------------------------------------------------
# 3. KONFIGURASI PIPELINE DETEKSI AI & MULTIMODAL
# -----------------------------------------------------------------------------
# Konstanta smoothing untuk Reciprocal Rank Fusion (RRF), standar akademik k = 60
RRF_K=60

# Batas maksimum ukuran berkas unggahan PDF dalam Megabytes (MB)
MAX_FILE_SIZE_MB=25

# Ambang batas deteksi prototipe (kemiripan semantik)
PROTO_TEMPLATE_THRESHOLD=0.75
PROTO_REVIEW_THRESHOLD=0.50

# -----------------------------------------------------------------------------
# 4. PENYEDIA LLM & CHATBOT AKADEMIS
# -----------------------------------------------------------------------------
# Host Ollama lokal (diarahkan ke host mesin melalui Docker host-gateway)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:8b

# Kunci API Penyedia Cloud (Opsional jika menggunakan API komersial eksternal)
KUNCI_API_GEMINI=
KUNCI_API_OPENAI=
KUNCI_API_GROQ=

# -----------------------------------------------------------------------------
# 5. PORT & JARINGAN PRODUKSI
# -----------------------------------------------------------------------------
# Port internal layanan API Gateway Backend Bun
PORT=3000

# Port internal layanan FastAPI AI Service
FASTAPI_PORT=8000

# URL endpoint backend yang diakses frontend saat build / runtime Nginx
VITE_API_BACKEND_URL=/api
